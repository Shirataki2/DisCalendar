{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, guild_id, name, description, notifications, notification_mentions, color, is_all_day, start_at, end_at, created_at, created_by, updated_by, updated_at\n        FROM events WHERE guild_id = $1 AND (series_id IS NULL OR (start_at < (CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Tokyo') + INTERVAL '730 days' AND end_at >= (CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Tokyo') - INTERVAL '366 days')) ORDER BY start_at, id\n        ",
