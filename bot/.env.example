# ローカル開発用の環境変数。コピーして .env を作成する (cargo run 時に dotenvy が読む)
# cp .env.example .env

# api と同じ DB。Bot は guilds / events / event_settings / guild_config を読み書きするだけで、
# マイグレーションは api が起動時に適用する
DATABASE_URL=postgres://USER@localhost:5432/discalendar_dev
DATABASE_MAX_CONNECTIONS=5

# Discord Developer Portal > Bot のトークン (api/.env の DISCORD_BOT_TOKEN と同じ値)
DISCORD_BOT_TOKEN=

# Bot の参加・退出を埋め込みで通知するテキストチャンネルの ID (任意。未設定なら通知しない)
BOT_LOG_CHANNEL_ID=

# /help と /invite で案内する招待 URL (任意。web/.env.local の DISCORD_BOT_INVITE_URL と同じ)。
# 未設定なら起動時にアプリケーション ID から「bot + applications.commands スコープ、通知に必要な権限」で組み立てる
DISCORD_BOT_INVITE_URL=

RUST_LOG=info,discalendar_bot=debug,sqlx=warn
