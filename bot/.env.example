# ローカル開発用の環境変数。コピーして .env を作成する (cargo run 時に dotenvy が読む)
# cp .env.example .env

# api と同じ DB。Bot は guilds / events / event_settings / guild_config を読み書きするだけで、
# マイグレーションは api が起動時に適用する
DATABASE_URL=postgres://USER@localhost:5432/discalendar_dev
DATABASE_MAX_CONNECTIONS=5

# Discord Developer Portal > Bot のトークン (api/.env の DISCORD_BOT_TOKEN と同じ値)
DISCORD_BOT_TOKEN=

# Bot の参加・退出を埋め込みで通知するテキストチャンネルの ID (任意。未設定なら通知しない)
BOT_LOG_CHANNEL_ID=

# /help と /invite で案内する招待 URL (任意。web/.env.local の DISCORD_BOT_INVITE_URL と同じ)。
# 未設定なら起動時にアプリケーション ID から「bot + applications.commands スコープ、通知とイベント作成に必要な権限」で組み立てる。
# 設定する場合、permissions は「イベントの作成」(#94) を含む 17594333613056 にする
DISCORD_BOT_INVITE_URL=

# 毎日 JST 0:00 に日付入りアイコンへ更新する DisCalendar サポートサーバーの ID (任意。未設定なら更新しない)
BOT_SUPPORT_GUILD_ID=

RUST_LOG=info,discalendar_bot=debug,sqlx=warn

# エラー監視 (Sentry、#17。任意)。未設定なら何も送らない (ローカル開発では通常設定しない)。
# SENTRY_ENVIRONMENT は未設定ならビルドに応じて development / production になる。
# SENTRY_SAMPLE_RATE (0.0〜1.0、既定 1.0) はエラーイベントの送信率 (無料枠の保護用)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_SAMPLE_RATE=1.0
