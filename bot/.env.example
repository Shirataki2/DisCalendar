# ローカル開発用の環境変数。コピーして .env を作成する (cargo run 時に dotenvy が読む)
# cp .env.example .env

# api と同じ DB。Bot は guilds テーブルを読み書きするだけで、マイグレーションは api が起動時に適用する
DATABASE_URL=postgres://USER@localhost:5432/discalendar_dev
DATABASE_MAX_CONNECTIONS=5

# Discord Developer Portal > Bot のトークン (api/.env の DISCORD_BOT_TOKEN と同じ値)
DISCORD_BOT_TOKEN=

# Bot の参加・退出を埋め込みで通知するテキストチャンネルの ID (任意。未設定なら通知しない)
BOT_LOG_CHANNEL_ID=

RUST_LOG=info,discalendar_bot=debug,sqlx=warn
