# ホストの /etc/discalendar/backup.env に置く設定 (#102)。root だけが読めるようにする:
#   sudo install -o root -g root -m 600 backup.env.example /etc/discalendar/backup.env && sudo vi /etc/discalendar/backup.env
# R2 のアクセスキーが入るので、値をリポジトリ・Issue・ログに貼らないこと。

# compose.yaml と .env のあるディレクトリ (本番は /opt/discalendar、staging は別ディレクトリ)
COMPOSE_DIR=/opt/discalendar

# アップロード先のキーの接頭辞。本番と staging を同じバケットに入れて分けるために使う
BACKUP_PREFIX=production

# Cloudflare のアカウント ID (R2 のエンドポイントの組み立てに使う 32 桁)
R2_ACCOUNT_ID=

# バックアップ用 R2 バケット (infra/terraform の backup_bucket_name)
R2_BUCKET=discalendar-backups

# このバケットだけにスコープした R2 の API トークン (権限は Object Read & Write)。
# 発行手順は infra/README.md。ホストが乗っ取られたときに過去のバックアップを消されないよう、
# バケット側にロック (backup_lock_days) を掛けてある
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 任意: 既定から変えるときだけ
# DB_USER=discalendar
# DB_NAME=discalendar
# ダンプを一時的に置く場所 (ここに DB と同じくらいの空きが要る)
# BACKUP_WORK_DIR=/var/tmp
# aws-cli のイメージ (バージョンを上げるときだけ変える)
# AWS_CLI_IMAGE=public.ecr.aws/aws-cli/aws-cli:2.36.32
