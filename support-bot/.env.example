# ローカル開発用の環境変数。コピーして .env を作成する (cargo run 時に dotenvy が読む)
# cp .env.example .env

# サポート用のデータベース。本体 (api/bot) の discalendar_dev とは別にする
# (同じ DB に置くと _sqlx_migrations を api と取り合う)。無ければ起動時に作り、マイグレーションも起動時に当てる。
# cargo test / cargo sqlx prepare もこの値を使う
DATABASE_URL=postgres://USER@localhost:5432/discalendar_support_dev
DATABASE_MAX_CONNECTIONS=5

# サポート用 Bot (本体とは別の Discord アプリ) のトークン。本体の DISCORD_BOT_TOKEN とは別の値
# (compose のルートの .env と同じ名前。DISCORD_BOT_TOKEN でも読むが、こちらが優先)
SUPPORT_BOT_DISCORD_TOKEN=

# サポートサーバーの ID。これ以外のサーバーに招待されたら即退出する
SUPPORT_GUILD_ID=

# 記録するチャンネルの ID (カンマ区切り)。フォーラムは配下の投稿を、テキストチャンネルはそのチャンネルの発言を記録する
SUPPORT_RECORD_CHANNEL_IDS=

# スタッフとして扱うロールの ID (カンマ区切り)
SUPPORT_STAFF_ROLE_IDS=

# 未返信の通知・リマインド・毎朝のまとめを投稿するスタッフ用チャンネルの ID
SUPPORT_STAFF_CHANNEL_ID=

# 任意: 本番に出た版の更新内容を告知する「更新通知」チャンネルの ID (#430)。未設定なら告知しない。
# 手元で設定すると、手元の版を一度だけ告知するので、本番の告知先とは別のチャンネルにする
SUPPORT_RELEASE_CHANNEL_ID=

RUST_LOG=info,discalendar_support_bot=debug,sqlx=warn

# エラー監視 (Sentry。任意)。未設定なら何も送らない。SENTRY_DSN でも渡せる (そちらが優先)
# SUPPORT_BOT_SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_SAMPLE_RATE=1.0
