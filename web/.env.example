# ローカル開発用の環境変数。コピーして .env.local を作成する
# cp .env.example .env.local

# Better Auth のユーザー/セッションを保存する Postgres
DATABASE_URL=postgres://USER@localhost:5432/discalendar_dev

# openssl rand -hex 32 で生成
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000

# Discord Developer Portal (https://discord.com/developers/applications) の
# OAuth2 設定から取得。Redirects に
# http://localhost:3000/api/auth/callback/discord を登録すること
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
