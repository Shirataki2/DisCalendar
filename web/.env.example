# ローカル開発用の環境変数。コピーして .env.local を作成する
# cp .env.example .env.local

# Better Auth のユーザー/セッションを保存する Postgres
DATABASE_URL=postgres://USER@localhost:5432/discalendar_dev

# openssl rand -hex 32 で生成
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000

# Discord Developer Portal (https://discord.com/developers/applications) の
# OAuth2 設定から取得。Redirects に
# http://localhost:3000/api/auth/callback/discord を登録すること
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Rust API (api/) の URL。next.config.ts の rewrites で /local/api/* をここへプロキシし、
# Server Component からは直接呼ぶ。未設定なら http://127.0.0.1:8080
API_URL=http://127.0.0.1:8080

# Bot の招待 URL (サーバー選択画面で Bot 未参加のサーバーに表示。旧実装の INVITATION_URL)。
# 未設定なら DISCORD_CLIENT_ID から組み立てる
# DISCORD_BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=...&scope=bot%20applications.commands&permissions=...
