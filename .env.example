# docker compose 用の設定。コピーして .env を作る (compose.yaml が変数展開に使う)。
#   cp .env.example .env
# ローカル開発 (pnpm dev / cargo run) の環境変数は web/.env.example, api/.env.example, bot/.env.example を見ること。
# .env は git 管理外。値をコード・ログ・Issue に貼らないこと

# compose 内の Postgres (db サービス) のパスワード。web / api / bot はこの DB に
# postgres://discalendar:<POSTGRES_PASSWORD>@db:5432/discalendar で接続する。
# 値はそのまま URL に埋め込まれる (compose は URL エンコードしない) ので、英数字だけにすること
# (`/` `?` `#` `%` `@` `:` などを含めると api / web / bot が接続できない)。openssl rand -hex 24 で生成すればよい
POSTGRES_PASSWORD=

# web と api で共有するセッション署名鍵 (openssl rand -hex 32)
BETTER_AUTH_SECRET=

# ホスト側で公開するポート (コンテナ内は 3000 固定)。既定では 127.0.0.1 にだけ bind する。
# LAN の別端末からアクセスしたいときだけ WEB_BIND=0.0.0.0 にする (staging は Tunnel 経由なので 127.0.0.1 のまま)
WEB_PORT=3000
# WEB_BIND=127.0.0.1
# ブラウザから見た web の URL。Discord Developer Portal の OAuth2 Redirects に
# <BETTER_AUTH_URL>/api/auth/callback/discord を登録する。
# 未設定なら http://localhost:<WEB_PORT> になる。ドメインで公開するとき (staging / 本番) だけ設定する
# BETTER_AUTH_URL=https://staging.discalendar.app
# OGP など絶対 URL が必要なメタ情報の基準 (docker compose build のときだけ効く。web は next build 時に焼き込む)。
# 未設定なら https://discalendar.app。staging のように別ドメインで出すときは BETTER_AUTH_URL と同じ値にする。
# GHCR のイメージを pull する staging では、デプロイ (.github/workflows/deploy-staging.yml) が build-arg で渡す
# NEXT_PUBLIC_SITE_URL=https://staging.discalendar.app

# Discord Developer Portal > OAuth2 (web のログイン用)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord Developer Portal > Bot のトークン (api の権限計算と bot で使う)
DISCORD_BOT_TOKEN=

# 任意: Bot の招待 URL (未設定なら DISCORD_CLIENT_ID / アプリケーション ID から組み立てる)。
# 設定する場合、permissions は「イベントの作成」(#94) を含む 17594333613056 にする
DISCORD_BOT_INVITE_URL=
# 任意 (api): 管理コンソール (/admin) を使える Discord ユーザー ID (カンマ区切り)。未設定なら管理コンソールは誰も開けない
ADMIN_DISCORD_USER_IDS=
# 任意 (bot): 参加・退出ログを送るチャンネル ID / 日付入りアイコンを反映するサポートサーバー ID
BOT_LOG_CHANNEL_ID=
BOT_SUPPORT_GUILD_ID=

# 任意: エラー監視 (Sentry、#17)。Sentry のプロジェクトごとの DSN。未設定なら何も送らない。
# api / bot は実行時に読む。web はブラウザに配る値なので next build 時に焼き込まれ、
# GHCR のイメージを pull する staging / 本番ではデプロイ CI (deploy-staging.yml) が
# Repository variable WEB_SENTRY_DSN から build-arg で渡す (ここの値は docker compose build のときだけ効く)
# API_SENTRY_DSN=
# BOT_SENTRY_DSN=
# WEB_SENTRY_DSN=
# 環境の名前 (未設定なら production。staging のホストでは staging にする)。
# Sentry の environment タグと、Grafana に送るログの env ラベル (#104) の両方に使う
# SENTRY_ENVIRONMENT=staging
# api / bot がエラーを送る割合 (0.0〜1.0、未設定なら 1.0)。同種エラーの急増で無料枠を
# 使い切りそうなときに、イメージを作り直さずに絞るための逃し弁
# SENTRY_SAMPLE_RATE=1.0

# 任意: ログ集約 (Grafana Cloud、#104)。compose の alloy が各サービスのコンテナログを Loki に送る。
# --profile logging (下の COMPOSE_PROFILES) を付けたときだけ起動するので、値を入れてから profile を足すこと。
# URL と User は Grafana Cloud のスタック詳細 (Loki の「Send Logs」) に出る。トークンは logs:write の
# アクセスポリシートークン (Access Policies で作る)。手順は infra/README.md
# GRAFANA_CLOUD_LOKI_URL=https://logs-prod-030.grafana.net/loki/api/v1/push
# GRAFANA_CLOUD_LOKI_USER=1234567
# GRAFANA_CLOUD_LOKI_TOKEN=
# api / bot のログの形式 (未設定なら json)。Loki 側でレベルを絞れるよう既定は JSON にしてあるので、
# ローカルで docker compose logs を人が読むときだけ text にする
# LOG_FORMAT=text

# 任意: イメージのタグ (GHCR から pull するとき。ローカルで build するなら latest のままでよい)。
# staging ではデプロイ (.github/workflows/deploy-staging.yml) が sha-xxxxxxx に書き換える。
# docker compose build するときは api の管理コンソール (/admin) に出すビルド情報としても使われる
# IMAGE_TAG=latest
# 任意: web だけ別のタグを使いたいとき (未設定なら IMAGE_TAG と同じ)。OGP などの絶対 URL はビルド時に
# 焼き込まれるので、staging ではデプロイが <IMAGE_TAG>-staging (staging のドメイン版) に書き換える
# WEB_IMAGE_TAG=
# 任意: docker compose build で api に焼き込むコミット SHA (管理コンソールの /admin に出る)。
# 未設定なら「不明」と表示されるだけ。GHCR のイメージにはデプロイのワークフローが自動で入れる
# GIT_SHA=
# 任意: 既定で起動する profile (bot = Discord Bot、tunnel = Cloudflare Tunnel、logging = ログ集約の alloy)。
# staging / 本番では bot,tunnel,logging
# COMPOSE_PROFILES=bot,tunnel,logging
# 任意 (tunnel): Cloudflare Zero Trust の Tunnel トークン
# TUNNEL_TOKEN=
# 任意: ログレベル
# API_RUST_LOG=info,discalendar_api=debug,sqlx=warn
# BOT_RUST_LOG=info,discalendar_bot=debug,sqlx=warn
