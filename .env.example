# docker compose 用の設定。コピーして .env を作る (compose.yaml が変数展開に使う)。
#   cp .env.example .env
# ローカル開発 (pnpm dev / cargo run) の環境変数は web/.env.example, api/.env.example, bot/.env.example を見ること。
# .env は git 管理外。値をコード・ログ・Issue に貼らないこと

# compose 内の Postgres (db サービス) のパスワード。web / api / bot はこの DB に
# postgres://discalendar:<POSTGRES_PASSWORD>@db:5432/discalendar で接続する。
# 値はそのまま URL に埋め込まれる (compose は URL エンコードしない) ので、英数字だけにすること
# (`/` `?` `#` `%` `@` `:` などを含めると api / web / bot が接続できない)。openssl rand -hex 24 で生成すればよい
POSTGRES_PASSWORD=

# web と api で共有するセッション署名鍵 (openssl rand -hex 32)
BETTER_AUTH_SECRET=

# ホスト側で公開するポート (コンテナ内は 3000 固定)
WEB_PORT=3000
# ブラウザから見た web の URL。Discord Developer Portal の OAuth2 Redirects に
# <BETTER_AUTH_URL>/api/auth/callback/discord を登録する。
# 未設定なら http://localhost:<WEB_PORT> になる。ドメインで公開するとき (staging / 本番) だけ設定する
# BETTER_AUTH_URL=https://staging.discalendar.app

# Discord Developer Portal > OAuth2 (web のログイン用)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord Developer Portal > Bot のトークン (api の権限計算と bot で使う)
DISCORD_BOT_TOKEN=

# 任意: Bot の招待 URL (未設定なら DISCORD_CLIENT_ID / アプリケーション ID から組み立てる)
DISCORD_BOT_INVITE_URL=
# 任意 (bot): 参加・退出ログを送るチャンネル ID / 日付入りアイコンを反映するサポートサーバー ID
BOT_LOG_CHANNEL_ID=
BOT_SUPPORT_GUILD_ID=

# 任意: イメージのタグ (GHCR から pull するとき。ローカルで build するなら latest のままでよい)
# IMAGE_TAG=latest
# 任意: ログレベル
# API_RUST_LOG=info,discalendar_api=debug,sqlx=warn
# BOT_RUST_LOG=info,discalendar_bot=debug,sqlx=warn
