# ローカル開発用の環境変数。コピーして .env を作成する (cargo run 時に dotenvy が読む)
# cp .env.example .env

HOST=127.0.0.1
PORT=8080

# web と同じ DB を使う (Better Auth の session / account テーブルを参照するため)
DATABASE_URL=postgres://USER@localhost:5432/discalendar_dev
DATABASE_MAX_CONNECTIONS=5

# Discord Developer Portal > Bot のトークン。
# ギルドのメンバー確認と権限計算 (GET /guilds/{id}, GET /guilds/{id}/members/{user}) に使う
DISCORD_BOT_TOKEN=

# Discord API のベース URL (任意)。未設定なら https://discord.com/api/v10。
# web の E2E テスト (web/e2e) がモックサーバーに向けるためのもので、通常は設定しない
# DISCORD_API_BASE_URL=http://127.0.0.1:8190

# web/.env.local の BETTER_AUTH_SECRET と同じ値。セッション cookie の署名検証に使う
BETTER_AUTH_SECRET=

# Better Auth の cookie プレフィックス (web 側で advanced.cookiePrefix を変えていなければそのまま)
AUTH_COOKIE_PREFIX=better-auth

# 管理コンソール (web の /admin、api の /admin/*) を使える Discord ユーザー ID (カンマ区切り)。
# Discord の「開発者モード」でユーザーを右クリック →「ユーザー ID をコピー」で取れる 17〜20 桁の数字。
# 未設定なら管理者はいない (全員 403 / web では 404)。数字以外が混ざっていると起動時にエラーになる
ADMIN_DISCORD_USER_IDS=

# 管理コンソールの SQL コンソール (POST /admin/sql) が使う接続文字列 (任意)。
# 未設定なら DATABASE_URL と同じ DB にロール discalendar_sql_console_<DB 名> でログインする (ロールは api が起動時に作り、
# パスワードは BETTER_AUTH_SECRET から導出する)。api の接続ユーザーに CREATEROLE / superuser が無く
# ロールを手で用意する環境でだけ、そのロールの接続文字列を指定する (README 参照)
# SQL_CONSOLE_DATABASE_URL=postgres://discalendar_sql_console_discalendar_dev:PASSWORD@localhost:5432/discalendar_dev

RUST_LOG=info,discalendar_api=debug,sqlx=warn

# エラー監視 (Sentry、#17。任意)。未設定なら何も送らない (ローカル開発では通常設定しない)。
# SENTRY_ENVIRONMENT は未設定ならビルドに応じて development / production になる。
# SENTRY_SAMPLE_RATE (0.0〜1.0、既定 1.0) はエラーイベントの送信率 (無料枠の保護用)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_SAMPLE_RATE=1.0
