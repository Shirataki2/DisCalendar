  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, actor_user_id, actor_discord_user_id, action, target_type, target_id,\n               before, after, detail, created_at\n        FROM admin_audit_logs\n        WHERE ($1::text = '' OR action = $1)\n          AND ($2::text = '' OR actor_discord_user_id = $2)\n        ORDER BY id DESC\n        LIMIT $3 OFFSET $4\n        ",
