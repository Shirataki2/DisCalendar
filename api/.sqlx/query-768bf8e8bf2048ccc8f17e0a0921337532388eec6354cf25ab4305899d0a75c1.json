  "db_name": "PostgreSQL",
  "query": "\n        SELECT id AS \"id!\", \"createdAt\" AS \"created_at!\", \"updatedAt\" AS \"updated_at!\",\n               \"expiresAt\" AS \"expires_at!\", \"ipAddress\" AS \"ip_address?\", \"userAgent\" AS \"user_agent?\",\n               (\"expiresAt\" <= now()) AS \"expired!\"\n        FROM \"session\"\n        WHERE \"userId\" = $1\n        ORDER BY \"createdAt\" DESC\n        LIMIT $2\n        ",
