{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, name, is_all_day, start_at, end_at, deleted_at AS \"deleted_at!\", deleted_by,\n               deleted_at + make_interval(days => $2) AS \"expires_at!\"\n        FROM events\n        WHERE guild_id = $1 AND deleted_at IS NOT NULL\n        ORDER BY deleted_at DESC, id DESC\n        LIMIT $3\n        ",
