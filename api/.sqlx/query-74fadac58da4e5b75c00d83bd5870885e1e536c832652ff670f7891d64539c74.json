{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id AS \"id!\", u.name AS \"name!\", a.\"accountId\" AS \"discord_user_id!\"\n        FROM \"session\" s\n        JOIN \"user\" u ON u.id = s.\"userId\"\n        JOIN \"account\" a ON a.\"userId\" = u.id AND a.\"providerId\" = 'discord'\n        WHERE s.token = $1 AND s.\"expiresAt\" > now()\n        LIMIT 1\n        ",
